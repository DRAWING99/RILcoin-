pragma solidity ^0.8.20;

interface ITargetToken {
    function owner() external view returns (address);
}

contract ReverseSmartContractFirewall {
    
    address public securityAdmin;
    
    // قائمة سوداء بالعقود التي تم تعديلها برمجياً بشكل خبيث بعد الإطلاق
    mapping(address => bool) public blacklistedContracts;

    constructor() {
        securityAdmin = msg.sender;
    }

    // وظيفة لفحص العقد قبل السماح للمستخدم بالتوقيع والتفاعل معه
    function verifyContractSafety(address _targetContract) external view returns (bool isSafe, string memory report) {
        if (blacklistedContracts[_targetContract]) {
            return (false, "CRITICAL: This contract is blacklisted by SmartShield AI.");
        }

        // فحص حجم الكود البرمجي للتأكد من أنه عقد ذكي وليس محفظة عادية
        uint256 codeSize;
        assembly { codeSize := extcodesize(_targetContract) }
        if (codeSize == 0) {
            return (true, "Notice: Target is a standard wallet, not a smart contract.");
        }

        // فحص برميجي تخيلي لوجود مالك متحكم بالعقد بشكل مشبوه
        try ITargetToken(_targetContract).owner() returns (address contractOwner) {
            if (contractOwner == address(0)) {
                return (true, "Safe: Contract ownership is renounced.");
            }
            return (true, "Warning: Contract has an active owner. Investigate permissions.");
        } catch {
            return (true, "Passed: Contract does not contain hidden centralized ownership functions.");
        }
    }

    function addMaliciousContract(address _badContract) external {
        require(msg.sender == securityAdmin, "Only SmartShield Admin");
        blacklistedContracts[_badContract] = true;
    }
}
