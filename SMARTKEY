pragma solidity ^0.8.20;

contract SecureProjectWallet {
    address public owner;
    // تحديد حد أقصى للسحب اليومي لحماية المحفظة من التصيد
    uint256 public maxDailyLimit = 5000 * 10**18; 
    uint256 public spentToday;
    uint256 public lastResetTime;

    struct Frame {
        address to;      // الجهة المستهدفة (مثلاً عقد حصص المشروع)
        bytes data;      // البيانات المراد تنفيذها (شراء، قفل، إلخ)
        uint256 value;   // قيمة العملات المرسلة
    }

    modifier onlyOwner() {
        require(msg.sender == owner, "Not the wallet owner!");
        _;
    }

    constructor(address _owner) {
        owner = _owner;
        lastResetTime = block.timestamp;
    }

    // تطبيق ميزة EIP-8141: تجميع المعاملات في مصفوفة إطارات (Frames)
    function executeFrames(Frame[] calldata frames) external onlyOwner {
        // إعادة تعيين الحد اليومي لو مر 24 ساعة
        if (block.timestamp >= lastResetTime + 1 days) {
            spentToday = 0;
            lastResetTime = block.timestamp;
        }

        for (uint256 i = 0; i < frames.length; i++) {
            // فحص الأمان ضد التصيد: التأكد من عدم تجاوز الحد اليومي قبل التنفيذ
            if (frames[i].value > 0) {
                spentToday += frames[i].value;
                require(spentToday <= maxDailyLimit, "Security Alert: Daily limit exceeded!");
            }

            // تنفيذ الإطار (Frame Execution)
            (bool success, ) = frames[i].to.call{value: frames[i].value}(frames[i].data);
            require(success, "One of the frames failed. Transaction reverted.");
        }
    }
}
