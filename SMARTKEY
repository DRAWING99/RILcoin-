    /// أ. ترقية البنوك وتطهير البيانات سبرانياً بالذكاء الاصطناعي مع حفظ الملفات من التلف
    pub fn live_upgrade_and_sanitize(
        &mut self, 
        institution_id: &str, 
        bank_type: BankType, 
        raw_legacy_payload: &str, 
        legacy_balance_float: f64
    ) -> Result<String, String> {
        
        let mut sanitized_payload = raw_legacy_payload.to_string();
