pragma solidity ^0.8.20;

contract SmartShieldScoringSystem {

    struct SecurityMetrics {
        uint256 creationBlock;
        uint256 lockedLiquidityPercentage;
        bool isVerifiedSource;
        bool hasMintFunction;
    }

    mapping(address => SecurityMetrics) public registry;

    // تسجيل بيانات الرمز في النظام لتقييمه
    function registerAssetMetrics(
        address _token, 
        uint256 _lockedLiquidity, 
        bool _verified, 
        bool _mintable
    ) external {
        registry[_token] = SecurityMetrics({
            creationBlock: block.number,
            lockedLiquidityPercentage: _lockedLiquidity,
            isVerifiedSource: _verified,
            hasMintFunction: _mintable
        });
    }

    // معادلة حساب التقييم الأمني التلقائي من 100
    function calculateSecurityScore(address _token) external view returns (uint256 score) {
        SecurityMetrics memory asset = registry[_token];
        if(asset.creationBlock == 0) return 0; // غير مسجل

        uint256 currentScore = 100;

        // 1. خصم نقاط إذا كانت السيولة المقفلة ضعيفة (أقل من 50%)
        if (asset.lockedLiquidityPercentage < 50) {
            currentScore -= 30;
        }

        // 2. خصم نقاط إذا كان الكود المصدري غير موثق علناً
        if (!asset.isVerifiedSource) {
            currentScore -= 40;
        }

        // 3. خصم نقاط إذا كان العقد يسمح بطباعة رموز إضافية (Mint) بدون سقف
        if (asset.hasMintFunction) {
            currentScore -= 20;
        }

        return currentScore;
    }
}
