        let upgraded_vault = UpgradedSecureVault {
            secure_id: Uuid::new_v4(),
            client_hash: crypto_hash.clone(),
            calibrated_balance_cents: calibrated_cents,
            token_standard: TokenStandard::ERC20,
            mpc_signatures: mpc_keys,
        };

        self.institutions.insert(institution_id.to_string(), inst_type);
        self.secured_assets_vaults.insert(institution_id.to_string(), upgraded_vault);

        let success_log = format!("✅ [ترقية وتطهير سبراني مطلق]: تمت ترقية الجهة [{}] وتوثيق أصولها ببصمة البلوكشين: 0x_{}", institution_id, &crypto_hash[0..12]);
        self.technical_immutable_ledger.push(success_log.clone());
        
        Ok(success_log)
    }

