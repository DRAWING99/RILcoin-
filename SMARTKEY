// 1. تعريف أنواع المعايير الرقمية المعتمدة
// ==========================================
type TokenStandard = 'ERC-20' | 'ERC-721' | 'ERC-1155' | 'ERC-404';

interface AssetFilterState {
    selectedStandards: Set<TokenStandard>;
    searchQuery: string;
    activeFilterCount: number;
}

interface MarketAsset {
    id: string;
    name: string;
    symbol: string;
    standard: TokenStandard;
    balance: string;
    securityScore: number;
}

// ==========================================
// 2. فئة إدارة الفرز والربط الفوري (Filter Controller)
// ==========================================
class SmartShieldFilterController {
    private state: AssetFilterState;
    private allAssets: MarketAsset[] 

    constructor() {
        // الحالة الابتدائية بناءً على صورتك (جميع الخيارات الـ 4 مفعلة تلقائياً)
        this.state = {
            selectedStandards: new Set<TokenStandard>(['ERC-20', 'ERC-721', 'ERC-1155', 'ERC-404']),
            searchQuery: '',
            activeFilterCount: 4
        };
    }

    // محاكاة جلب الأصول المرمزة للبنوك والشركات من محرك Rust
    public setAssets(assets: MarketAsset[]): void {
        this.allAssets = assets;
    }

    /**
     * تفعيل أو إلغاء تفعيل خيار معيار (مثل الضغط على المربع الأزرق في الصورة)
     */
    public toggleStandard(standard: TokenStandard): void {
        if (this.state.selectedStandards.has(standard)) {
            this.state.selectedStandards.delete(standard); // إلغاء التحديد
        } else {
            this.state.selectedStandards.add(standard); // تفعيل التحديد
        }
        
        // تحديث عداد الأيقونة الزرقاء الظاهرة بالصورة (رقم 4)
        this.state.activeFilterCount = this.state.selectedStandards.size;
        this.renderActiveFilterCount();
        this.applyFilterAndSync();
    }

    /**
     * البحث المباشر عبر صندوق "أو رمزه" الموجود في الصورة
     */
    public handleSearch(query: string): void {
        this.state.searchQuery = query.trim().toLowerCase();
        this.applyFilterAndSync();
    }

    /**
     * وظيفة زر "إعادة ضبط" المذكور في صورتك لتصفير الفلاتر وإعادة كل شيء
     */
    public resetFilters(): void {
        println("🔄 تم الضغط على: إعادة ضبط الفلاتر");
        this.state.selectedStandards = new Set<TokenStandard>(['ERC-20', 'ERC-721', 'ERC-1155', 'ERC-404']);
        this.state.searchQuery = '';
        this.state.activeFilterCount = 4;
        
        this.renderActiveFilterCount();
        this.applyFilterAndSync();
    }

    /**
     * تصفية البيانات ومزامنتها بالتوازي مع الـ Backend بدون أي بطء تقني
     */
    private applyFilterAndSync(): MarketAsset[] {
