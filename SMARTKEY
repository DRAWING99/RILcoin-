        };

        self.institutions.insert(institution_id.to_string(), bank_type);
        self.secured_assets_vaults.insert(institution_id.to_string(), upgraded_vault);

        Ok(format!("✅ [ترقية البنية التحتية المصرفية]: تمت ترقية البنك [{}] ونقل أرصدته للنظام الموحد بالبصمة: 0x_{}", institution_id, &crypto_hash[0..12]))
