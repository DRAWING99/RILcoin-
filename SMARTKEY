    "function spentToday() view returns (uint256)",
    "function dailyLimit() view returns (uint256)"
];

// دالة إرسال الأموال الآمنة من واجهة تطبيقك
async function sendSecureTransaction(userProvider, toAddress, amountInEth, payloadData = "0x") {
    const signer = await userProvider.getSigner();
    const walletContract = new ethers.Contract(contractAddress, contractABI, signer);
    
    const amountInWei = ethers.parseEther(amountInEth);
    const limit = await walletContract.dailyLimit();
    const spent = await walletContract.spentToday();
    
    // فحص آلي: إذا كانت المعاملة تتجاوز الحد اليومي، يتم تحويلها تلقائياً إلى نظام الإطار المحمي بزمن
    if (spent + amountInWei > limit) {
        console.warn("⚠️ المعاملة تتجاوز الحد الآمن! تفعيل نظام إطار الأمان المشروط بفترة 24 ساعة لصد القرصنة والفدية.");
        const tx = await walletContract.initDelayedFrame(toAddress, amountInWei, payloadData);
        const receipt = await tx.wait();
        alert(`✅ تم إنشاء إطار معاملة آمن بنجاح! سيتم التنفيذ بعد 24 ساعة. رقم الإطار: ${receipt.logs[0].args[0]}`);
    } else {
        // تنفيذ فوري لأنها ضمن النطاق الآمن للمستخدم
        const tx = await walletContract.executeInstantFrame(toAddress, amountInWei, payloadData);
        await tx.wait();
        alert("✅ تم تنفيذ المعاملة الفورية بنجاح وأمان!");
    }
}
