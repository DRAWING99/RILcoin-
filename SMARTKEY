        if (blacklistedContracts[_targetContract]) {
            return (false, "CRITICAL: This contract is blacklisted by SmartShield AI.");
        }

        // فحص حجم الكود البرمجي للتأكد من أنه عقد ذكي وليس محفظة عادية
        uint256 codeSize;
