        // الرسوم تمثل 0.01% من قيمة المعاملة وبحد أقصى منافس جداً ثابت
        let dynamic_fee = std::cmp::min((amount_cents as f64 * 0.0001) as u64, 500); // 500 سنت كحد أقصى (5 دولار فقط مهما كان حجم الحوالة)

        // خصم المبلغ وإتمام التسوية الفورية في الذاكرة عريضة النطاق
        sender_vault.calibrated_balance_cents -= amount_cents;
        
        let receiver_vault = self.secured_assets_vaults.get_mut(receiver_bic).unwrap();
        receiver_vault.calibrated_balance_cents += amount_cents - (dynamic_fee as u128);

