    pub entity_id: String,
    pub credit_score: u32,           // التقييم الائتماني الذكي (من 300 إلى 850)
    pub total_assets_value_usd: u128,
    pub total_liabilities_usd: u128,
    pub issue_date: String,
    pub digital_signature: String,   // توقيع دفتري مشفر غير قابل للتزوير
}

#[derive(Debug, Clone)]
pub struct FinancialInstitution {
    pub id: String,
    pub name: String,
    pub inst_type: InstitutionType,
    pub fiat_liquidity_reserve: u128,
}

// ==========================================
// 3. المحرك الشامل للترقية والترميز والسجلات الدفترية
// ==========================================
pub struct NextGenFinancialSystem {
    pub institutions: HashMap<String, FinancialInstitution>,
    pub tokenized_registry: HashMap<String, TokenizedAsset>,
    pub credit_registry: HashMap<String, CreditAndFinancialReport>,
    pub system_logs: Vec<String>, // السجل الدفتري العام للبلوكشين (Immutable Ledger)
}

impl NextGenFinancialSystem {
    pub fn new() -> Self {
        Self {
            institutions: HashMap::new(),
            tokenized_registry: HashMap::new(),
            credit_registry: HashMap::new(),
            system_logs: Vec::new(),
        }
    }

    /// أ. ترقية البنوك (المركزية أو التجارية) والشركات إلى النظام الجديد دون فقدان بيانات
    pub fn upgrade_institution(&mut self, id: &str, name: &str, inst_type: InstitutionType, legacy_reserve: u128) {
        let upgraded = FinancialInstitution {
            id: id.to_string(),
            name: name.to_string(),
            inst_type: inst_type.clone(),
            fiat_liquidity_reserve: legacy_reserve,
        };
        self.institutions.insert(id.to_string(), upgraded);
        
        let log_msg = format!("🔗 [ترقية مؤسسية بنجاح]: تمت ترقية البنك/الشركة [{}] بنوع {:?} ونقل سيولتها للنظام الدفتري المتطور.", name, inst_type);
        self.system_logs.push(log_msg.clone());
        println!("{}", log_msg);
    }

    /// ب. ترميز أصول الشركات (أسهم، عقارات، معادن ثقيلة) داخل سوق المال الموحد
    pub fn tokenize_corporate_asset(&mut self, company_id: &str, symbol: &str, asset_type: TokenType, total_supply: u128, legal_doc: &str) {
        if !self.institutions.contains_key(company_id) {
            println!("⚠️ خطأ: الشركة غير مسجلة أو لم تتم ترقيتها للنظام بعد.");
            return;
        }

        let asset = TokenizedAsset {
            asset_id: Uuid::new_v4(),
            owner_company_id: company_id.to_string(),
            token_type: asset_type.clone(),
            total_shares: total_supply,
            underlying_legal_doc: legal_doc.to_string(),
        };

        self.tokenized_registry.insert(symbol.to_string(), asset);
        
        let log_msg = format!("📊 [ترميز أصول أسواق المال]: قامت الشركة [{}] بترميز أصل من نوع {:?} بالرمز [{}] بإجمالي [{}] حصة رقمية.", company_id, asset_type, symbol, total_supply);
        self.system_logs.push(log_msg.clone());
        println!("{}", log_msg);
    }

    /// ج. استخراج وإصدار السجلات المالية والائتمانية الدفترية للعملاء والمستثمرين تلقائياً
    pub fn generate_and_sign_credit_report(&mut self, entity_id: &str, score: u32, assets: u128, liabilities: u128) -> CreditAndFinancialReport {
        let report_id = Uuid::new_v4();
        
        // توليد بصمة رقمية فريدة (Cryptographic Signature) لتوثيق السجل الدفتري
        let raw_signature_data = format!("{}-{}-{}-{}", report_id, entity_id, score, assets);
        let mut hasher = sha2::Sha256::new();
        sha2::Digest::update(&mut hasher, raw_signature_data.as_bytes());
        let crypto_signature = format!("0x_signed_{:x}", hasher.finalize());

        let report = CreditAndFinancialReport {
            report_id,
            entity_id: entity_id.to_string(),
            credit_score: score,
            total_assets_value_usd: assets,
            total_liabilities_usd: liabilities,
            issue_date: Utc::now().to_rfc3339(),
            digital_signature: crypto_signature.clone(),
        };

        self.credit_registry.insert(entity_id.to_string(), report.clone());
        
        let log_msg = format!("🗒 [إصدار سجل مالي دفتري]: تم استخراج التقرير الائتماني الموثق للجهة [{}] بالتوقيع الرقمي الخالي من الأخطاء: {}", entity_id, crypto_signature);
        self.system_logs.push(log_msg);
        
        report
    }
}

