            federal_anchor_vault: InternationalFederalVault {
                total_global_fiat_reserve_cents: 0,
                active_issued_tokens: 0,
            },
            registered_global_enterprises: HashMap::new(),
            connected_exchanges: HashMap::new(),
            absolute_immutable_ledger: Vec::new(),
        }
    }

    /// 1. رفع أوراق الاعتماد من أي منطقة في العالم وإصدار "جواز السفر المالي الدولي" في ثوانٍ
    pub fn global_register_enterprise(
        &mut self, 
        name: &str, 
        country: &str, 
        initial_deposit: f64
    ) -> Result<String, String> {
        
        let enterprise_id = Uuid::new_v4();
        let deposit_cents = (initial_deposit * 100.0) as u128;

        // 2. إيداع السيولة فورياً في حساب البنك الفيدرالي الموحد للبورصة الرقمية الدولية
        self.federal_anchor_vault.total_global_fiat_reserve_cents += deposit_cents;
        self.federal_anchor_vault.active_issued_tokens += deposit_cents; // صك تلقائي 1:1 مقابل الإيداع الفعلي

        let passport = GlobalEnterprisePassport {
            enterprise_id,
            name: name.to_string(),
            origin_country: country.to_string(),
            verified_by_treaty: true, // تفعيل التوثيق التلقائي بموجب البروتوكول الدولي
            linked_federal_balance_cents: deposit_cents,
        };

        self.registered_global_enterprises.insert(name.to_string(), passport);

        let log_success = format!(
            "🌐 [البروتوكول التجاري العالمي]: تم اعتماد شركة [{}] من [{}] رقمياً. السيولة المودعة بالحساب الفيدرالي الموحد: {} وحدة. تم صك الأصول وتفعيل الحماية الكمومية 24/7.",
            name, country, initial_deposit
        );
        self.absolute_immutable_ledger.push(log_success.clone());

        Ok(log_success)
    }

    /// 3. ربط وتفعيل أي بورصة مركزية أو لامركزية بالشبكة العالمية الموحدة
    pub fn connect_global_exchange(&mut self, exchange_name: &str, ex_type: ExchangeType) {
        self.connected_exchanges.insert(exchange_name.to_string(), ex_type.clone());
        let log_msg = format!("🔗 [ربط البورصات]: تم ربط وتفعيل البورصة [{}] بنوع {:?} تحت مظلة البروتوكول الدولي المشترك لنظام SmartKey.", exchange_name, ex_type);
        self.absolute_immutable_ledger.push(log_msg);
    }
}
