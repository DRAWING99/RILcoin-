        }

        let sum: u64 = raw_prices_from_sources.iter().sum();
        let verified_avg_price = sum / sources_count as u64;

        let oracle_price = SecuredOraclePrice {
            symbol: symbol.to_string(),
            aggregated_price_cents: verified_avg_price,
            verification_sources_count: sources_count as u32,
            last_update: Utc::now().to_rfc3339(),
        };

