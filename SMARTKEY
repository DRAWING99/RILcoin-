    pub fn execute_cross_border_settlement(
        &mut self, 
        sender_bic: &str, 
        receiver_bic: &str, 
        asset: &str, 
        amount_cents: u128
    ) -> Result<String, String> {
        
        // التحقق من وجود البنوك وصلاحيتها في الشبكة السيادية
        if !self.institutions.contains_key(sender_bic) || !self.institutions.contains_key(receiver_bic) {
