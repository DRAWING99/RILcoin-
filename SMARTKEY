pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";

contract SmartShieldQuarantine is ERC20, Ownable {
    
    // خريطة لتحديد الحسابات أو الرموز الموضوعة في الحجر الصحي
    mapping(address => bool) public isQuarantined;

    // أحداث لتسجيل عمليات الحجر وفك الحجر
    event AssetQuarantined(address indexed target);
    event AssetReleased(address indexed target);

    constructor() ERC20("SmartShield Security Token", "SST") Ownable(msg.sender) {
        _mint(msg.sender, 1000000 * 10**decimals());
    }

    // وظيفة لوضع محفظة أو رمز مشبوه في الحجر الصحي
    function quarantineAddress(address _target) external onlyOwner {
        isQuarantined[_target] = true;
        emit AssetQuarantined(_target);
    }

    // وظيفة لفك الحجر بعد التأكد من الأمان
    function releaseFromQuarantine(address _target) external onlyOwner {
        isQuarantined[_target] = false;
        emit AssetReleased(_target);
    }

    // تعديل الوظيفة الأساسية للنقل لمنع حركة الأصول المحجوزة
    function _update(address from, address to, uint256 value) internal override {
        require(!isQuarantined[from], "SmartShield: Action denied. Asset is in QUARANTINE due to security risk.");
        require(!isQuarantined[to], "SmartShield: Action denied. Target address is quarantined.");
        super._update(from, to, value);
    }
}
