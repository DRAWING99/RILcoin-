    });
    
    const aiSecurityResult = await aiSentinelResponse.json();

    // 🛡️ درع الحظر الاستباقي: شل حركة الطلب فوراً إذا رصد الذكاء الاصطناعي أي محاولة تصيد أو شذوذ سلوكي
    if (!aiSecurityResult.isSafe) {
